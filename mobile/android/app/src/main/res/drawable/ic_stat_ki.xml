<!--
  Status-bar notification icon.

  Android draws the small icon as a mask: every non-transparent pixel becomes
  a flat white (or themed) shape. Passing the full-colour launcher icon — which
  is what every notification here used to do — therefore rendered as a solid
  white square. This is the required silhouette: a rising-bars mark with an
  upward arrow, on transparent.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- three rising bars -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3,15h3.2v6H3z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9.4,11.5h3.2v9.5H9.4z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M15.8,7h3.2v14h-3.2z" />

    <!-- growth arrow across the tops -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.6,11.9l-1.5,-1.6 6,-5.6 3.6,3.1 5.1,-5.3 -2.5,0 0,-2.1 6.1,0 0,6 -2.1,0 0,-2.4 -6.4,6.6 -3.6,-3.1z" />
</vector>
