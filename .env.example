# Copy this file to `.env` on each machine and fill in the values.
# Never commit `.env` itself (it's in .gitignore).

# Django
# Generate a fresh key for each environment, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=changeme-generate-a-fresh-key-per-environment
DEBUG=False

# Comma-separated hostnames this site is served on. REQUIRED when DEBUG=False
# (Django returns HTTP 400 DisallowedHost otherwise).
ALLOWED_HOSTS=example.com,www.example.com
# Comma-separated origins (scheme + host) trusted for CSRF on HTTPS POST/admin.
# Needed when serving over HTTPS behind a proxy/load balancer.
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Postgres
DB_NAME=silicondb
DB_USER=crmuser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Google Drive integration (per-client document folders)
# Keyless via service-account impersonation. On the server you must:
#   1. gcloud auth application-default login (as the deploy user)
#   2. gcloud services enable iamcredentials.googleapis.com drive.googleapis.com
#   3. Grant deploy user roles/iam.serviceAccountTokenCreator on the SA below
#   4. Share the "All Clients" folder with the SA email as Editor
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_IMPERSONATE_SA=

# Optional: rclone remote for nightly DB backups (used by scripts/backup_db.sh).
# One-time setup on the server:  rclone config   (pick Google Drive, follow prompts)
# Then set this to "<remote_name>:<folder_path>", e.g.  mydrive:Silicon-CRM-Backups
BACKUP_RCLONE_REMOTE=

# Optional: RTA mutual-fund feeds (CAMS/KFintech distributor mailback import).
# Register the ARN on camsonline.com + mfs.kfintech.com, subscribe the daily
# mailback reports to a dedicated mailbox, then point these at that mailbox
# (IMAP over SSL). Leave unset to disable the daily import (it silently no-ops).
RTA_FEED_IMAP_HOST=
RTA_FEED_IMAP_PORT=993
RTA_FEED_IMAP_USER=
RTA_FEED_IMAP_PASSWORD=
RTA_FEED_IMAP_FOLDER=INBOX
# Only emails from these sender domains are processed.
RTA_FEED_SENDERS=camsonline.com,kfintech.com,karvy.com
# Extra zip passwords to try besides the ARN codes configured in the app.
RTA_FEED_ZIP_PASSWORDS=

# Optional: Sentry error monitoring. Get a DSN at https://sentry.io
# When set, every uncaught exception in production is reported.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_RATE=0.1
